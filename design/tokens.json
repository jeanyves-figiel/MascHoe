{
  "$description": "Thirstr design tokens (docs/spec/design-system.md). W3C Design Tokens format. Source of truth for apps/mobile/src/theme.",
  "color": {
    "bg": {
      "base": { "$type": "color", "$value": { "dark": "#0B0B0F", "light": "#FFFFFF" } },
      "raised": { "$type": "color", "$value": { "dark": "#16161D", "light": "#F4F4F7" } },
      "overlay": { "$type": "color", "$value": { "dark": "#1F1F28", "light": "#FFFFFF" } }
    },
    "fg": {
      "primary": { "$type": "color", "$value": { "dark": "#F5F5F7", "light": "#111116" } },
      "secondary": { "$type": "color", "$value": { "dark": "#A1A1AA", "light": "#52525B" } },
      "muted": { "$type": "color", "$value": { "dark": "#6B6B76", "light": "#8A8A94" } }
    },
    "line": { "$type": "color", "$value": { "dark": "#2A2A33", "light": "#E4E4E7" } },
    "mode": {
      "hookup": { "$type": "color", "$value": { "dark": "#FF7A33", "light": "#E8611A" } },
      "sport": { "$type": "color", "$value": { "dark": "#C6F432", "light": "#6E9A00" } },
      "friends": { "$type": "color", "$value": { "dark": "#A98BFF", "light": "#7A5AF0" } }
    },
    "trust": { "$type": "color", "$value": { "dark": "#4DA3FF", "light": "#1F7AE0" } },
    "trustSoft": { "$type": "color", "$value": { "dark": "#6FB6FF", "light": "#4B95EA" } },
    "safety": { "$type": "color", "$value": { "dark": "#8FE3A0", "light": "#1F9D4A" } },
    "danger": { "$type": "color", "$value": { "dark": "#FF5A5F", "light": "#D92D33" } },
    "warn": { "$type": "color", "$value": { "dark": "#FFC94D", "light": "#B07A00" } }
  },
  "type": {
    "display": { "$type": "typography", "$value": { "fontSize": 32, "lineHeight": 38, "fontWeight": "700" } },
    "title": { "$type": "typography", "$value": { "fontSize": 22, "lineHeight": 28, "fontWeight": "700" } },
    "headline": { "$type": "typography", "$value": { "fontSize": 17, "lineHeight": 22, "fontWeight": "600" } },
    "body": { "$type": "typography", "$value": { "fontSize": 15, "lineHeight": 21, "fontWeight": "400" } },
    "meta": { "$type": "typography", "$value": { "fontSize": 13, "lineHeight": 18, "fontWeight": "500" } },
    "caption": { "$type": "typography", "$value": { "fontSize": 11, "lineHeight": 14, "fontWeight": "600" } }
  },
  "space": { "$type": "dimension", "$value": [2, 4, 8, 12, 16, 20, 24, 32, 48] },
  "radius": { "sm": 8, "md": 12, "lg": 20, "pill": 999 },
  "motion": { "fast": 120, "base": 220, "slow": 360 }
}
