{
  "expo": {
    "name": "Thirstr",
    "slug": "thirstr",
    "scheme": "thirstr",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#17142E",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#17142E"
    },
    "ios": {
      "bundleIdentifier": "app.thirstr",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.thirstr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#17142E"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Thirstr turns your position into an area on your phone. Only the area is shared."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos for your profile."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Thirstr uses the camera for the selfie check. Photos are checked on your phone and deleted; nothing is uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-apple-authentication",
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-notifications",
        {}
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
