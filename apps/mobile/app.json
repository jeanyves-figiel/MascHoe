{
  "expo": {
    "name": "Thirstr",
    "slug": "thirstr",
    "scheme": "thirstr",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#0B0B0F" },
    "ios": { "bundleIdentifier": "app.thirstr", "supportsTablet": false },
    "android": { "package": "app.thirstr", "adaptiveIcon": { "foregroundImage": "./assets/android-icon-foreground.png", "backgroundColor": "#0B0B0F" } },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro", "output": "single" },
    "plugins": [
      ["expo-location", { "locationWhenInUsePermission": "Thirstr turns your position into an area on your phone. Only the area is shared." }],
      ["expo-image-picker", { "photosPermission": "Pick photos for your profile." }]
    ]
  }
}
