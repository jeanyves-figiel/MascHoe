{
  "expo": {
    "name": "Thirstr",
    "slug": "thirstr",
    "scheme": "thirstr",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#17142E",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#17142E"
    },
    "ios": {
      "bundleIdentifier": "app.thirstr",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.thirstr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#17142E"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Thirstr turns your position into an area on your phone. Only the area is shared."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos for your profile, or photos and videos to send in a chat. Nothing leaves your phone until you send it."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Thirstr uses the camera for the selfie check (checked on your phone and deleted), to take a photo to send in a chat, and to record a video check someone asked you for.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Pick photos for your profile, or photos and videos to send in a chat. Nothing leaves your phone until you send it.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-apple-authentication",
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Thirstr uses Face ID to unlock the app and confirm you're OK during a check-in."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Thirstr uses motion only for shake-to-erase, when you turn it on."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
